{
  "name": "fridge-helper-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js tests/*.test.ts",
    "start": "node tools/dev.mjs",
    "check": "node tools/check.mjs && tsc --noEmit",
    "dev": "node tools/dev.mjs",
    "dev:frontend": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 8011 --strictPort",
    "start:server": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
